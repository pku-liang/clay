#[opcode(7'b0001011)]
#[funct3(0x7)]
rtype gemm2x2(rs1: 32, rs2: 32) -> (rd: 32) {
    let a0 = mem[rs1];
    let b0 = mem[rs1 + 16];
    let a1 = mem[rs1 + 4];
    let b2 = mem[rs1 + 24];
    let b1 = mem[rs1 + 20];
    let b3 = mem[rs1 + 28];
    let a2 = mem[rs1 + 8];
    let a3 = mem[rs1 + 12];
    let a = a0 * b0 + a1 * b2;
    let b = a0 * b1 + a1 * b3;
    let c = a2 * b0 + a3 * b2;
    let d = a2 * b1 + a3 * b3;
    mem[rs2] = a;
    mem[rs2 + 4] = b;
    mem[rs2 + 8] = c;
    mem[rs2 + 12] = d;
    rd = 1;
}