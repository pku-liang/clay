pub Regfile: Regfile = {
    "regfile" <name:Ident> "(" <width:Number> "," <depth:Number> ")" ";" => Regfile {
        name,
        width: width.value().to_u32().unwrap(),
        depth: depth.value().to_u32().unwrap()
    }
};

pub Expr: Box<Expr> = {
    #[precedence(level="0")]
    "(" <mut list:List<ExprReset>> ")" => {
        if list.len() == 1 {
            list.pop().unwrap()
        } else {
            Expr::Tuple(list).boxed()
        }
    },
    <Number> => Expr::Lit(<>).boxed(),
    <Ident> => Expr::Ident(<>).boxed(),
    "memread" "(" <addr:ExprReset> ")" => Expr::MemRead(addr).boxed(),
    "memwrite" "(" <addr:ExprReset> "," <data:ExprReset> <mask:("," <ExprReset>)?> ")" => Expr::MemWrite(addr, data, mask).boxed(),
    <id:Ident> "(" <args:List<ExprReset>> ")" => Expr::Call(id, args).boxed(),

    "$signed" "(" <expr:ExprReset> ")" => Expr::Unary(UnaryOp::SignedCast, expr).boxed(),
    "$unsigned" "(" <expr:ExprReset> ")" => Expr::Unary(UnaryOp::UnsignedCast, expr).boxed(),

    #[precedence(level="1")]
    "mem" "[" <index:ExprReset> "]" => Expr::Memory(index).boxed(),
    <expr:Expr> "[" <index:ExprReset> "]" => Expr::Index(expr, index).boxed(),
    <expr:Expr> "[" <begin:ExprReset> ":" <end:ExprReset> "]" => Expr::Slice(expr, begin, end).boxed(),
    "{" <list:List<ExprReset>> "}" => Expr::Concat(list).boxed(),
    "{" <n:Number> "{" <expr:ExprReset> "}" "}" => Expr::Repeat(n.value().to_u32().unwrap(), expr).boxed(),

    #[precedence(level="2")]
    <op:UnOp> <expr:Expr> => Expr::Unary(op, expr).boxed(),

    #[precedence(level="3")]
    #[assoc(side="left")]
    <lhs:Expr> <op:MulOp> <rhs:Expr> => Expr::Binary(op, lhs, rhs).boxed(),

    #[precedence(level="4")]
    #[assoc(side="left")]
    <lhs:Expr> <op:AddOp> <rhs:Expr> => Expr::Binary(op, lhs, rhs).boxed(),

    #[precedence(level="5")]
    #[assoc(side="left")]
    <lhs:Expr> <op:ShiftOp> <rhs:Expr> => Expr::Binary(op, lhs, rhs).boxed(),

    #[precedence(level="6")]
    #[assoc(side="left")]
    <lhs:Expr> <op:RelOp> <rhs:Expr> => Expr::Binary(op, lhs, rhs).boxed(),

    #[precedence(level="7")]
    #[assoc(side="left")]
    <lhs:Expr> <op:EqOp> <rhs:Expr> => Expr::Binary(op, lhs, rhs).boxed(),

    #[precedence(level="8")]
    #[assoc(side="left")]
    <lhs:Expr> <op:AndOp> <rhs:Expr> => Expr::Binary(op, lhs, rhs).boxed(),

    #[precedence(level="9")]
    #[assoc(side="left")]
    <lhs:Expr> <op:XorOp> <rhs:Expr> => Expr::Binary(op, lhs, rhs).boxed(),

    #[precedence(level="10")]
    #[assoc(side="left")]
    <lhs:Expr> <op:OrOp> <rhs:Expr> => Expr::Binary(op, lhs, rhs).boxed(),

    #[precedence(level="11")]
    #[assoc(side="left")]
    "if" <cond:ExprReset> "{" <then_br:ExprReset> "}" "else" "{" <else_br:Expr> "}" => Expr::If(cond, then_br, else_br).boxed(),
    "match" <var:ExprReset> "{" <arms:(<ExprReset> "=>" <ExprReset> ",")+> "}" => Expr::Match(var, arms).boxed(),
}

UnOp: UnaryOp = {
    "-" => UnaryOp::Neg,
    "~" => UnaryOp::BitNot,
    "!" => UnaryOp::Not,
}

EqOp: BinaryOp = {
    "==" => BinaryOp::Eq,
    "!=" => BinaryOp::Ne,
}

AndOp: BinaryOp = {
    "&" => BinaryOp::BitAnd,
    "&&" => BinaryOp::And,
}

XorOp: BinaryOp = {
    "^" => BinaryOp::BitXor,
}

OrOp: BinaryOp = {
    "|" => BinaryOp::BitOr,
    "||" => BinaryOp::Or,
}

RelOp: BinaryOp = {
    "<" => BinaryOp::Lt,
    "<=" => BinaryOp::Le,
    ">" => BinaryOp::Gt,
    ">=" => BinaryOp::Ge,
}

ShiftOp: BinaryOp = {
    "<<" => BinaryOp::LShift,
    ">>" => BinaryOp::RShift,
}

AddOp: BinaryOp = {
    "+" => BinaryOp::Add,
    "-" => BinaryOp::Sub,
}

MulOp: BinaryOp = {
    "*" => BinaryOp::Mul,
    "/" => BinaryOp::Div,
    "%" => BinaryOp::Rem,
}

ExprReset = Expr;

ProcPart: ProcPart = {
    ConstStmt => {
        let (name, value) = <>;
        ProcPart::Const {
            name,
            value
        }
    },
    Regfile => ProcPart::Regfile(<>),
    Module => ProcPart::Module(<>),
    Flow => ProcPart::Flow(<>),
}

pub Proc: Proc = ProcPart* => Proc::from_parts(<>);